# Configurações do servidor Node.js
APP_HOST=0.0.0.0
APP_PORT=8000
SERPER_API_KEY=
SERPAPI_API_KEY=
# Geocodificação do endereço do cliente (fechar orçamento) e o mapa da Fase 4 usam
# Nominatim + tiles do OpenStreetMap — 100% gratuito, sem key e sem conta,
# nenhuma variável de ambiente necessária aqui nem no front-end.

# MongoDB (docker-compose.yml sobe um container local em mongodb://localhost:27017)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=comprador_inviolavel

# Conta admin de recuperação — semeada (upsert) a cada boot do servidor. Serve pra entrar caso
# esqueça a senha da sua própria conta: troque DEV_PASSWORD aqui e reinicie o servidor.
DEV_EMAIL=
DEV_PASSWORD=
