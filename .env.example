# Configurações do servidor Node.js
APP_HOST=0.0.0.0
APP_PORT=8000
SERPER_API_KEY=
SERPAPI_API_KEY=
# Geocodificação do endereço do cliente (fechar orçamento) e o mapa da Fase 4 usam
# Nominatim + tiles do OpenStreetMap — 100% gratuito, sem key e sem conta,
# nenhuma variável de ambiente necessária aqui nem no front-end.

# MongoDB (docker-compose.yml sobe um container local em mongodb://localhost:27017)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=comprador_inviolavel

# Conta admin de recuperação — semeada (upsert) a cada boot do servidor. Serve pra entrar caso
# esqueça a senha da sua própria conta: troque DEV_PASSWORD aqui e reinicie o servidor.
DEV_EMAIL=
DEV_PASSWORD=

# IA (aba "Validar orçamento (PDF)") — chave em https://openrouter.ai/settings/keys.
OPENROUTER_API_KEY=
# Opcional: força um modelo específico antes da lista padrão de fallback (lib/openrouter.js).
OPENROUTER_MODEL=

# Recuperação de senha por e-mail (Outlook/Microsoft 365). SMTP_FROM tem que ser o mesmo e-mail de SMTP_USER.
# Precisa de "SMTP autenticado" habilitado na caixa (e senha de app se houver MFA). Sem SMTP, o link sai no console.
# APP_URL = endereço público do sistema (vai no link do e-mail); padrão http://localhost:APP_PORT.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
APP_URL=
